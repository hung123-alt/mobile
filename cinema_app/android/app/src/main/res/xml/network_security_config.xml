<?xml version="1.0" encoding="utf-8"?>
<!-- LOP 4 - CHONG CLEARTEXT (HTTP tran) tren Android.
  VÌ SAO CAN FILE NAY?
  - Mobile khac web: khong dung cookie nen khong lo CSRF, nhung du lieu
    truyen qua HTTP se bi doc trom (nhat la wifi cong cong).
  - Android mac dinh van cho phep HTTP. File nay cam HTTP toan app,
    chi mo ngoai le cho localhost/10.0.2.2 de lap trinh local (debug).
  - Production (release) bat buoc https — ApiService se nem loi neu gap http.
  Khai bao o AndroidManifest: android:networkSecurityConfig="@xml/network_security_config". -->
<network-security-config>
  <!-- Mac dinh: CAM http -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Ngoai le DEBUG: cho phep http toi may dev qua emulator -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>
</network-security-config>
