{
  "name": "cinema-firebase-uploader",
  "version": "1.0.0",
  "description": "Script import data JSON lên Cloud Firestore cho Cinema App",
  "main": "import.js",
  "scripts": {
    "import": "node import.js",
    "import:all": "node import.js --all",
    "import:movies": "node import.js --file=./data/movies.sample.json --collection=movies",
    "import:genres": "node import.js --file=./data/genres.sample.json --collection=genres",
    "fix:names": "node rename_collections.js",
    "fix:preview": "node rename_collections.js --dry-run"
  },
  "keywords": ["firebase", "firestore", "seed", "import", "json"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase-admin": "^13.0.0"
  }
}

